# Copie ce fichier en .env et adapte les valeurs.
DATABASE_URL=sqlite:///./bourses.db
# DATABASE_URL=postgresql+psycopg://bourses:bourses@localhost:5432/bourses
SECRET_KEY=change-moi-avec-une-longue-chaine-aleatoire
CORS_ORIGINS=http://localhost:3000
ADMIN_EMAILS=admin@example.org

# IA (facultatif). Sans clé, la plateforme marche en mode hors-ligne (règles et modèles).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_FREE_GENERATIONS_PER_DAY=20

# Collecte
SCRAPER_USER_AGENT=ScholarFitBot/0.1 (+https://ton-site.example/bot)
SCRAPER_MIN_DELAY_SECONDS=5

# Accompagnement : true = conseiller attribué automatiquement, false = choix par un administrateur
COACHING_AUTO_ASSIGN=true

# Offres d'accompagnement (prix en F CFA)
OFFER_STANDARD_PRICE=15000
OFFER_PREMIUM_PRICE=35000

# Collecte automatique pendant que l'API tourne : sources, découverte IA dans le monde entier,
# vérification des liens, expirations, alertes. 0 = désactivée (planifier alors « python -m app.cli nightly »).
AUTO_COLLECT_HOURS=24
# Découverte de bourses par l'IA (nécessite ANTHROPIC_API_KEY) et nombre de recherches web par zone
AI_DISCOVERY_ENABLED=true
AI_DISCOVERY_MAX_SEARCHES=6
